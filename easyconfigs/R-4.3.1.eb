# Easyconfig authored for the SoftwareConfig-DeploymentSystem portfolio project
# Real, reviewable EasyBuild easyconfig syntax; not executed by a real `eb` install here.
easyblock = 'ConfigureMake'

name = 'R'
version = '4.3.1'

homepage = 'https://www.r-project.org/'
description = """R is a free software environment for statistical computing and graphics."""

toolchain = {'name': 'foss', 'version': '2023a'}

sources = ['%(name)s-%(version)s.tar.gz']
source_urls = ['https://example-mirror.hpc/%(namelower)s/']

dependencies = [
    ('GCC', '12.3.0'),
    ('OpenBLAS', '0.3.23'),
    ('zlib', '1.2.13'),
    ('ncurses', '6.4'),
    ('bzip2', '1.0.8'),
    ('SQLite', '3.42.0'),
]

moduleclass = 'lang'
