# Easyconfig authored for the SoftwareConfig-DeploymentSystem portfolio project
# Real, reviewable EasyBuild easyconfig syntax; not executed by a real `eb` install here.
easyblock = 'ConfigureMake'

name = 'ScaLAPACK'
version = '2.2.0'

homepage = 'https://www.netlib.org/scalapack/'
description = """The ScaLAPACK library includes a subset of LAPACK routines redesigned for distributed memory MIMD parallel computers."""

toolchain = {'name': 'gompi', 'version': '2023a'}

sources = ['%(name)s-%(version)s.tar.gz']
source_urls = ['https://example-mirror.hpc/%(namelower)s/']

dependencies = [
    ('GCC', '12.3.0'),
    ('OpenMPI', '4.1.5'),
    ('OpenBLAS', '0.3.23'),
]

moduleclass = 'numlib'
